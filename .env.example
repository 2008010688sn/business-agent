# Copy to .env. Do not put real secrets in git.
# Compose demo Postgres/Redis credentials are agent/agent.

POSTGRES_HOST=127.0.0.1
# WSL Ubuntu PostgreSQL 16 cluster listens on 5433 (not 5432).
POSTGRES_PORT=5433
POSTGRES_DB=business_agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent

REDIS_HOST=127.0.0.1
# WSL Redis for this project (host-network). Keep alive with scripts/wsl-keep-redis.sh
REDIS_PORT=16379

# Optional OpenAI-compatible chat/embedding. DemoModelSeeder upserts model_config when auto-seed=true.
AGENT_OPENAI_BASE_URL=
AGENT_OPENAI_API_KEY=
AGENT_OPENAI_CHAT_MODEL=
AGENT_OPENAI_EMBEDDING_MODEL=

AGENT_STORAGE_DIRECTORY=./data/files
AGENT_STORAGE_PUBLIC_BASE_URL=http://localhost:10108/ai
